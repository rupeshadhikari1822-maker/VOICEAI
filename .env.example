# ---------------------------------------------------------------------------
# Copy to .env. Nothing here is needed to run locally: the defaults use SQLite
# and ./storage_local, so `uvicorn app.main:app --reload` works with no account.
# ---------------------------------------------------------------------------

# --- database ---
# dev  : sqlite:///./voice.db
# prod : Supabase Postgres. Project -> Connect -> "Transaction pooler" URI
#        (port 6543; pooled, so it works from a small always-on API process):
#        postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./voice.db

# --- storage ---
# local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage_local

# Supabase Storage (S3-compatible; same account as the database and auth).
# Bucket must be created as PRIVATE in the Supabase dashboard (Storage -> New
# bucket) -- the app serves audio only through short-lived presigned URLs, and
# a public bucket would bypass that entirely.
# Access key + secret come from Storage -> Settings -> "S3 Connection" -> "New
# access key" (separate from the anon/service_role keys used for Auth/DB).
# S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
# S3_BUCKET=voice-corpus
# S3_REGION=<region shown in the same S3 Connection panel>
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Cloudflare R2 (S3-compatible, zero egress -- worth it once the corpus is
# large enough that repeated training-run downloads would rack up transfer
# costs elsewhere).
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET=voice-corpus
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Backblaze B2:        https://s3.<region>.backblazeb2.com
# MinIO (local):       http://localhost:9000
# DigitalOcean Spaces: https://<region>.digitaloceanspaces.com

# --- accounts (Supabase Auth: email/password + Google sign-in) ---
# No JWT secret to configure -- tokens are verified against Supabase's public
# JWKS (fetched from SUPABASE_URL itself), matching how Supabase now signs
# them (ES256 "JWT Signing Keys", not the older shared HS256 secret).
# Project Settings -> Data API in the Supabase dashboard.
# SUPABASE_URL=https://<project-ref>.supabase.co
# Safe to expose to the browser -- Supabase enforces access with Row Level
# Security, not by keeping this key secret. Handed to the frontend via
# GET /api/config so it isn't hardcoded into recorder.js.
# SUPABASE_ANON_KEY=

# --- app ---
# Must match the URL the browser loads, or presigned local uploads break.
PUBLIC_BASE_URL=http://localhost:8000
# Signs local upload URLs. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-change-me
PRESIGN_TTL_S=900

# --- consent ---
# Bump when docs/consent-ne.md changes. Old records keep pointing at the old text.
CONSENT_VERSION=2026-09-02-commercial-v1

# --- QC ---
# asr -> 30 dB SNR gate, tts -> 40 dB
QC_PROFILE=asr

# --- review (/review validation UI) ---
# Named staff tokens: name:token,name:token. Empty means /review returns 401.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(24))"
# This is staff-grade auth, not a public identity system. See docs/deployment.md.
REVIEWER_TOKENS=

# --- admin login (/admin/login -> POST /api/admin/login) ---
# Optional email/password gate in front of the token above, for a single
# hardcoded operator account (not a user table). Leaving ADMIN_EMAIL unset
# disables the login page; REVIEWER_TOKENS still works directly either way.
# Generate both: python scripts/set_admin_password.py you@example.com
# That prints an ADMIN_EMAIL/ADMIN_PASSWORD_HASH pair to paste here, and a
# matching REVIEWER_TOKENS=admin:<token> line -- the name must be "admin".
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# How long a playback URL stays valid. The bucket stays private.
PRESIGN_GET_TTL_S=300

# Review every one of a speaker's first N clips, then sample this fraction.
# Speaker quality is strongly autocorrelated, so reviewing all of a good
# speaker's output buys almost nothing.
REVIEW_WARMUP_CLIPS=20
REVIEW_SAMPLE_FRACTION=0.10
# Rejection rate above which a speaker snaps back to 100% review.
REVIEW_REJECT_RATE_TRIGGER=0.20
# The UI suggests a break after this many minutes; fatigue produces bad labels.
REVIEW_SESSION_MINUTES=45

# --- ASR pre-filter (optional: pip install faster-whisper) ---
# Removes 60-80% of the human queue. Without it, every QC-passing clip goes to
# a reviewer and /review works exactly the same.
ASR_MODEL=small
# CER below this auto-verifies; above the other auto-rejects as a misread.
# Tune per language: these depend on how well the normaliser fits the script.
ASR_AUTO_VERIFY_CER=0.10
ASR_AUTO_REJECT_CER=0.40
