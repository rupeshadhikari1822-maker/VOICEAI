# ---------------------------------------------------------------------------
# Copy to .env. Nothing here is needed to run locally: the defaults use SQLite
# and ./storage_local, so `uvicorn app.main:app --reload` works with no account.
# ---------------------------------------------------------------------------

# --- database ---
# dev  : sqlite:///./voice.db
# prod : postgresql+psycopg://user:pass@host:5432/voice
DATABASE_URL=sqlite:///./voice.db

# --- storage ---
# local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage_local

# Cloudflare R2 (recommended: S3-compatible, zero egress).
# Account ID is in the R2 dashboard URL.
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET=voice-corpus
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Backblaze B2:   https://s3.<region>.backblazeb2.com
# MinIO (local):  http://localhost:9000
# Supabase:       https://<project>.supabase.co/storage/v1/s3

# --- app ---
# Must match the URL the browser loads, or presigned local uploads break.
PUBLIC_BASE_URL=http://localhost:8000
# Signs local upload URLs. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-change-me
PRESIGN_TTL_S=900

# --- consent ---
# Bump when docs/consent-ne.md changes. Old records keep pointing at the old text.
CONSENT_VERSION=2026-09-01-v1

# --- QC ---
# asr -> 30 dB SNR gate, tts -> 40 dB
QC_PROFILE=asr
