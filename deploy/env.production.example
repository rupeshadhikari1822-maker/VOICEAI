# Production environment for record.cloudfrm.ai
#
# Copy to /srv/voice/.env, fill in, then:
#   sudo chown voice:voice /srv/voice/.env && sudo chmod 600 /srv/voice/.env
#
# This file holds bucket credentials and reviewer tokens. It must never be
# committed, and it must not be world-readable -- the systemd unit reads it as
# the `voice` user and nothing else needs it.

# --- app -----------------------------------------------------------------
# MUST match the HTTPS URL contributors actually open. Presigned local-upload
# URLs are built from it, and a mismatch makes uploads fail from phones while
# still working from the VPS itself -- a confusing failure to debug.
PUBLIC_BASE_URL=https://record.cloudfrm.ai

# Signs local upload/download URLs. Generate a real one:
#   python -c "import secrets;print(secrets.token_hex(32))"
# Leaving the default is a hole: anyone who reads the repo can forge upload URLs.
SECRET_KEY=CHANGE_ME

PRESIGN_TTL_S=900
MAX_CLIP_BYTES=41943040

# --- database ------------------------------------------------------------
# SQLite is fine for a pilot: one contributor records at a time and writes are
# small. Move to Postgres when two sessions overlap and you start seeing
# `database is locked`.
DATABASE_URL=sqlite:////srv/voice/voice.db
# DATABASE_URL=postgresql+psycopg://voice:PASSWORD@localhost:5432/voice

# --- storage -------------------------------------------------------------
# Production must be s3. On `local`, clip bytes flow through this box, the
# corpus lives on one disk with no versioning, and check_deployment.py fails.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=voice-corpus
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Bucket CORS must allow PUT and GET from https://record.cloudfrm.ai.
# Nothing on the server can verify this -- CORS is enforced by the browser, so
# a Python health check passes while a real phone fails. See deploy/README.md.

# --- consent -------------------------------------------------------------
# Must match docs/consent-ne.md as deployed. check_deployment.py compares the
# served text's SHA-256 against the repo's, because collecting under stale
# consent text is the one mistake here that cannot be fixed after the fact.
CONSENT_VERSION=2026-09-01-v1

# --- QC ------------------------------------------------------------------
# asr -> 30 dB SNR gate, tts -> 40 dB.
QC_PROFILE=asr

# --- review --------------------------------------------------------------
# name:token,name:token -- one distinct token per person.
#   python -c "import secrets;print(secrets.token_urlsafe(24))"
# Leave empty until you actually have reviewers; /review then returns 401 and
# nothing else is affected.
REVIEWER_TOKENS=

PRESIGN_GET_TTL_S=300
REVIEW_WARMUP_CLIPS=20
REVIEW_SAMPLE_FRACTION=0.10
REVIEW_REJECT_RATE_TRIGGER=0.20
REVIEW_SESSION_MINUTES=45

# --- ASR pre-filter (optional) -------------------------------------------
ASR_MODEL=small
ASR_AUTO_VERIFY_CER=0.10
ASR_AUTO_REJECT_CER=0.40
